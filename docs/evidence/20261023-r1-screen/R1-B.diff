+def _post_screen_preset(self, p, body, admin):
+    """`POST /api/screen/preset`：新增或更新预设（带 `preset_id` 即更新）。
+
+    body：`{preset_id?, name, pool, rules, as_of?, note?}`。
+    规则走与执行同一套 `parse_rules`：未知字段直接拒绝，不自动替换含义相近字段。
