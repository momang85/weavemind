+def _post_screen_preview(self, p, body, admin):
+    """`POST /api/screen/preview`：输入预览（股票池可用性、PIT 排除、规则校验）。
+
+    body：`{pool: [code...], as_of: YYYY-MM-DD, rules?: [...]}`。
