        {
          "step_id": "3",
          "capability": "report_generator",
          "instruction": "生成行业调研报告（Markdown，含表格与结论）",
          "timeout": 90,
          "depends_on": [
            "2"
          ]
        }
      ]
    },
    {
      "name": "董事会汇报",
      "goal": "生成面向董事会的可行性汇报：方案、成本ROI、风险与路线图",
      "steps": [
        {
          "step_id": "1",
          "capability": "web_search",
