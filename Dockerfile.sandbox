FROM python:3.12-slim

# 构建期代理（仅构建用）：构建容器经 --network=host 走宿主代理；
# 运行时容器 --network none 不受影响；不传 build-arg 时为空串即直连
ARG http_proxy
ARG https_proxy
ENV http_proxy=${http_proxy} https_proxy=${https_proxy}


# 沙箱镜像：仅用于 code_execution 隔离运行，禁止网络（docker run --network none）
# fonts-droid-fallback：matplotlib/seaborn 中文图表渲染必需（与 CI 一致）；nodejs：代码生成任务 JS 校验
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update -o Acquire::Retries=5 \
    && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
        nodejs \
        fontconfig \
    && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
        fonts-droid-fallback \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# 复制依赖并预装（代码生成任务常用库：matplotlib/jieba/pandas/scikit-learn/seaborn 等）
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt || true

# 沙箱内不保留任何密钥
# 只读根文件系统下，可写的家目录与 matplotlib 字体缓存必须落到 tmpfs /tmp
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    HOME=/tmp \
    MPLCONFIGDIR=/tmp/.matplotlib
CMD ["python"]
